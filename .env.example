# Эти значения задаются как СЕКРЕТЫ Cloudflare Worker'а, а не как обычные env-переменные:
#   wrangler secret put TELEGRAM_BOT_TOKEN
#   wrangler secret put TELEGRAM_WEBHOOK_SECRET
#   wrangler secret put GROQ_API_KEY          (опционально, если AI_PROVIDER=groq)
#   wrangler secret put OPENROUTER_API_KEY    (опционально, если AI_PROVIDER=openrouter)
#
# Этот файл — только для scripts/setup-webhook.sh (локальный запуск),
# .env НЕ коммитится и НЕ читается воркером напрямую.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# Произвольная секретная строка — часть пути вебхука и заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# URL воркера после деплоя, например https://kira-qmods-bot.<account>.workers.dev
WORKER_URL=https://kira-qmods-bot.<account>.workers.dev

# Нужны только если переключаете AI_PROVIDER в wrangler.toml
GROQ_API_KEY=
OPENROUTER_API_KEY=
