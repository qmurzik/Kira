; Engine configuration file.
config_version=5

[application]

config/name="KIRA.exe — По ту сторону экрана"
config/description="Уютная романтическая приключенческая игра о Кире и мире забытых историй."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.06, 0.05, 0.12, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.12, 1)

[autoload]

Settings="*res://scripts/autoload/settings.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
RelationshipManager="*res://scripts/autoload/relationship_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
UIKit="*res://scripts/autoload/ui_kit.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
MinigameManager="*res://scripts/autoload/minigame_manager.gd"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false
